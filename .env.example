# === Provider Selection ===
# LLM provider: google | openai | anthropic | ollama
LLM_PROVIDER=google
# Embedding provider: google | openai | ollama (anthropic has no embedding model)
EMBEDDING_PROVIDER=google

# === Model Names ===
# LLM model name (must match the provider)
LLM_MODEL=gemini-2.0-flash-exp
# Embedding model name (must match the provider)
EMBEDDING_MODEL=models/text-embedding-004

# === LLM Parameters ===
LLM_TEMPERATURE=0.3

# === API Keys (set the one matching your provider) ===
GOOGLE_API_KEY=your-google-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === Custom base URLs (for domestic providers, proxies, etc.) ===
# OPENAI_BASE_URL=https://your-openai-compatible-api.com/v1
# ANTHROPIC_BASE_URL=https://your-anthropic-compatible-api.com

# === Ollama (only needed if using ollama provider) ===
# OLLAMA_BASE_URL=http://localhost:11434

# === Model examples per provider ===
# Google:    gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
#            embedding: models/text-embedding-004, models/text-embedding-005
#            (no custom base URL support in standard SDK)
# OpenAI:    gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#            embedding: text-embedding-3-small, text-embedding-3-large
# Anthropic: claude-sonnet-4-20250514, claude-haiku-4-5-20251001
#            (no embedding, use openai or ollama for embedding)
# Ollama:    llama3, mistral, qwen2 (depends on locally installed models)
#            embedding: nomic-embed-text, mxbai-embed-large
